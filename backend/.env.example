# Copy this file to .env and fill in the values. Never commit .env.
SECRET_KEY=change-me

# Detailed error pages: True only on your own computer. Leave False on the server.
DEBUG=False

# Comma-separated domain names. Unset = app.safarigen.io,localhost,127.0.0.1,[::1]
# ALLOWED_HOSTS=app.safarigen.io

MAPBOX_ACCESS_TOKEN=
MAPBOX_STYLE=mapbox/light-v11
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# REACT_PRINT_URL is read by two PDF files that expect different values
# (pdf_view.py wants .../print, pricing_pdf.py wants the bare site URL).
# Left unset until that is fixed; both currently default to app.safarigen.io.
# REACT_PRINT_URL=
